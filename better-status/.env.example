# --- Talon.One (the only "Better Status" specific config) ---
TALON_URL=mycompany.europe-west1.talon.one
TALON_IAPI_KEY=

# --- Plumbing every calendar->Slack tool needs ---
SLACK_USER_TOKEN=xoxp-...            # scopes: users.profile:read, users.profile:write
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                # scope: calendar.events.readonly

# --- Optional ---
# INTERNAL_DOMAIN=talon.one          # default: domain of the calendar owner's email
# PROFILE_ID=                        # default: sha256 of the calendar owner's email
# POLL_SECONDS=60
