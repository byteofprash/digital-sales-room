rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isTalonOneAe() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@talon[.]one$');
    }

    // rooms/{slug} is the prospect-facing document: anyone with the link can
    // read it (the slug itself is the access control — see the workspace
    // Home plan's "audience model"). The collection can only be listed by an
    // AE asking for their own rooms (where ownerUid == their uid), so nobody
    // can enumerate other prospects' rooms. Only the owning AE can write, and
    // only a talon.one account can ever become an owner.
    match /rooms/{slug} {
      // Only published rooms are visible to prospects; drafts and archived
      // rooms are readable by their owner alone. Rooms created before
      // `status` existed count as published.
      allow get: if resource.data.get('status', 'published') == 'published'
        || (isTalonOneAe() && resource.data.ownerUid == request.auth.uid);
      allow list: if isTalonOneAe()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isTalonOneAe()
        && request.resource.data.ownerUid == request.auth.uid;

      // Status changes (draft / published / archived) go through the
      // server-side API, which enforces the allowed transitions; the client
      // may edit content but never flip the status itself.
      allow update: if isTalonOneAe()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('status', 'published')
          == resource.data.get('status', 'published');

      allow delete: if false;

      // Buyer Intent Signals: internal-only telemetry. Split into its own
      // document (instead of a field on `rooms/{slug}`) because security
      // rules can't redact individual fields from a `get` — this is the
      // only way a prospect's anonymous read of the parent doc can never
      // see it, not just have it hidden client-side.
      match /private/engagement {
        allow read, write: if isTalonOneAe()
          && get(/databases/$(database)/documents/rooms/$(slug)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
